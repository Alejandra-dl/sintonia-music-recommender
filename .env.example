# Copia este fichero como .env y rellena los valores.
# El fichero .env no se sube nunca a un repositorio: contiene credenciales.

# Clave gratuita de Last.fm: https://www.last.fm/api/account/create
LASTFM_API_KEY=

# Usuario con el que trabaja el proyecto si no se indica otro por parámetro.
# Cada usuario tiene su carpeta en datos/usuarios/.
TFM_USUARIO=usuario1

# ------------------------------------------------------------------
# Spotify
# ------------------------------------------------------------------
# Las mismas credenciales sirven para dos cosas:
#   - Las portadas de la web (modo aplicación, no hace falta iniciar sesión).
#   - Crear playlists en la cuenta del usuario (hace falta que autorice la app).
# Se sacan gratis en https://developer.spotify.com/dashboard creando una app.
# Si se dejan vacías, la web funciona igual: no hay portadas y el botón de crear
# playlist avisa de que la integración no está configurada.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Dirección a la que Spotify devuelve al usuario tras autorizar. Tiene que ser
# EXACTAMENTE la misma que esté dada de alta en "Redirect URIs" del panel de Spotify.
#
# IMPORTANTE: desde la migración de Spotify de noviembre de 2025 ya no se admite
# "localhost" como destino. En local hay que usar la dirección de bucle explícita
# 127.0.0.1, y en un despliegue real, HTTPS. Por el mismo motivo, la web hay que
# abrirla en el navegador por http://127.0.0.1:8501 y no por http://localhost:8501.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8501/spotify/callback

# Nombre con el que empiezan las playlists creadas: "<prefijo> · <estado de ánimo>".
PLAYLIST_PREFIJO=Sintonía

# ------------------------------------------------------------------
# Aplicación web
# ------------------------------------------------------------------
# Clave con la que Flask firma la cookie de sesión, donde se guarda el usuario
# elegido y el token de Spotify. Pon cualquier cadena larga y aleatoria; se puede
# generar con:  python -c "import secrets; print(secrets.token_urlsafe(32))"
CLAVE_SESION=

# Token de acceso a Jupyter (servicio jupyter del docker-compose).
JUPYTER_TOKEN=
